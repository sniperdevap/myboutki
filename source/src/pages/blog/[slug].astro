---
import Blog from '../../layouts/Blog.astro';
import { posts } from '../../blog/posts.js';
export function getStaticPaths() { return posts.map(p => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const SITE = 'https://myboutiki.com', url = `${SITE}/blog/${p.slug}/`;
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: p.en.title, description: p.en.desc, image: SITE + p.img, datePublished: p.date, dateModified: p.date, inLanguage: 'en', mainEntityOfPage: url,
    author: { '@type': 'Organization', name: 'myboutiki', url: SITE }, publisher: { '@type': 'Organization', name: 'myboutiki', logo: { '@type': 'ImageObject', url: SITE + '/img/favicon.png?v=2' } } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'myboutiki', item: SITE + '/' }, { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE + '/blog/' }, { '@type': 'ListItem', position: 3, name: p.en.title, item: url }] },
];
const more = posts.filter(x => x.slug !== p.slug).slice(0, 3);
---
<Blog title={p.en.title + ' | myboutiki'} description={p.en.desc} path={`/blog/${p.slug}/`} jsonld={jsonld} image={SITE + p.img} ogType="article">
  <article>
    <p><a href="/blog/" class="meta">← All articles</a></p>
    <span class="tag">{p.en.tag}</span>
    <h1>{p.en.title}</h1>
    <p class="meta">myboutiki · <time datetime={p.date}>{new Date(p.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time></p>
    <img class="hero" src={p.img} alt={p.en.title} width="1200" height="675" />
    <Fragment set:html={p.en.body} />
  </article>
  <h2 style="margin-top:44px">More from the blog</h2>
  <div class="cards">{more.map(x => <a class="card" href={`/blog/${x.slug}/`}><img src={x.img} alt="" loading="lazy" decoding="async" /><div><span class="tag">{x.en.tag}</span><h2>{x.en.title}</h2></div></a>)}</div>
</Blog>
