---
import Base from '../../../layouts/Base.astro';
const SITE = 'https://myboutki.com';
const cats = ['الملابس','الإكسسوارات','الساعات','العناية بالبشرة','الاستحمام والعناية','النظارات','العدسات اللاصقة','الأحذية','الإلكترونيات','المنزل والمعيشة','الرياضة','أخرى'];
const countries = ['الكويت','السعودية','الإمارات','البحرين','قطر','عُمان'];
const shots = [['/img/abaya.jpg','عباية سوداء بتطريز ذهبي للبيع على ماي بوتيكي'],['/img/watch.jpg','ساعة GMT فولاذية من متجر موثّق'],['/img/polo.jpg','قميص بولو أخضر من متجر ملابس رجالية في الكويت'],['/img/bag.jpg','حقيبة كتف جلدية عنابية للبيع']];
const features = [
  ['متجرك الخاص بدون إيجار','افتح ملف متجر خلال دقائق بشعارك ونبذتك ورقم هاتفك وواتساب. بدون عقد إيجار ولا تأمين ولا إيجار شهري.'],
  ['انشر منتجك في ثوانٍ','أضف حتى 10 صور وسعراً ووصفاً. يكتب ماي بوتيكي العنوان نيابةً عنك ويظهر منتجك فوراً.'],
  ['منشورات مصممة للتسوق','يتصفح المشترون المنتجات الجديدة مثل وسائل التواصل، ويشاهدون أحدث قطع البائع من دائرته، وينقرون مرتين للإعجاب.'],
  ['ابحث حسب الفئة','اعثر على ما تريده بالضبط بين الملابس والساعات والإكسسوارات والعناية بالبشرة والإلكترونيات وغيرها.'],
  ['اطلب عبر واتساب','يضيف المشتري المنتجات إلى السلة ويرسل للبائع رسالة واتساب واحدة فيها كل منتج وسعره ورابطه.'],
  ['راسل وتابع واحفظ','راسل البائعين داخل التطبيق، وتابع متاجرك المفضلة، واحفظ المنتجات في المفضلة لوقت لاحق.'],
  ['متاجر موثّقة','يمكن للبائعين توثيق متاجرهم بهوية حكومية والحصول على شارة زرقاء تبني الثقة وتضعهم في المقدمة.'],
  ['مصمم للخليج','الأسعار بالدينار الكويتي والريال السعودي والدرهم الإماراتي والدينار البحريني والريال القطري والريال العُماني، وأرقام هواتف خليجية لكل بائع.'],
];
const faq = [
  ['ما هو ماي بوتيكي؟','ماي بوتيكي سوق إلكتروني بأسلوب وسائل التواصل الاجتماعي مصمم للبائعين. بدلاً من استئجار محل، يفتح البائع متجراً مجانياً على ماي بوتيكي، وينشر منتجاته بالصور، ويبيع لمشترين يتصفحون ويبحثون ويطلبون بسهولة.'],
  ['هل أحتاج إلى استئجار محل للبيع على ماي بوتيكي؟','لا. ماي بوتيكي يغنيك عن استئجار محل. متجرك موجود على ماي بوتيكي، فتستطيع البيع من المنزل والوصول إلى مشترين في أنحاء الخليج بدون دفع إيجار.'],
  ['هل البيع على ماي بوتيكي مجاني؟','فتح المتجر ونشر المنتجات مجاني. ويمكن للبائعين الذين يريدون الشارة الزرقاء والظهور في المقدمة اختيار باقة التوثيق الاختيارية.'],
  ['كيف يدفع المشترون ويستلمون المنتجات؟','يضيف المشتري المنتجات إلى السلة ويضغط «اطلب عبر واتساب». تصل للبائع رسالة بكل المنتجات، ويتفق مع المشتري مباشرةً على الدفع والتوصيل.'],
  ['في أي دول يتوفر ماي بوتيكي؟','يُطلق ماي بوتيكي في الكويت والسعودية والإمارات والبحرين وقطر وعُمان.'],
  ['ماذا يمكنني أن أبيع على ماي بوتيكي؟','الملابس والعبايات، والإكسسوارات، والساعات، ومنتجات العناية بالبشرة، والاستحمام والعناية، والنظارات، والعدسات اللاصقة، والأحذية، والإلكترونيات، والمنزل والمعيشة، والرياضة وغيرها.'],
  ['متى يُطلق ماي بوتيكي؟','ماي بوتيكي قادم قريباً على الويب وأجهزة iPhone وأندرويد. تابع هذه الصفحة لموعد الإطلاق.'],
];
const jsonld = [
  { '@context':'https://schema.org','@type':'Organization','name':'myboutki','alternateName':'ماي بوتيكي','url':SITE,'logo':`${SITE}/img/favicon.png`,'email':'support@myboutki.com','areaServed':['Kuwait','Saudi Arabia','UAE','Bahrain','Qatar','Oman'],'contactPoint':{'@type':'ContactPoint','contactType':'customer support','email':'support@myboutki.com','availableLanguage':['Arabic','English']}},
  { '@context':'https://schema.org','@type':'WebSite','name':'ماي بوتيكي','url':`${SITE}/ar/`,'inLanguage':'ar','description':'سوق إلكتروني بأسلوب التواصل الاجتماعي للبائعين في الخليج للبيع أونلاين بدون إيجار محل.'},
  { '@context':'https://schema.org','@type':'MobileApplication','name':'myboutki','alternateName':'ماي بوتيكي','operatingSystem':'iOS, Android','applicationCategory':'ShoppingApplication','inLanguage':'ar','description':'افتح متجرك الخاص وانشر منتجاتك بالصور وبِع عبر واتساب بدون إيجار محل.','offers':{'@type':'Offer','price':'0','priceCurrency':'USD'},'url':`${SITE}/ar/`},
  { '@context':'https://schema.org','@type':'FAQPage','inLanguage':'ar','mainEntity':faq.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))},
];
---
<Base lang="ar" path="/ar/about/" title="ماي بوتيكي — بيع أونلاين بدون إيجار محل | سوق التواصل الاجتماعي في الخليج" description="ماي بوتيكي سوق إلكتروني بأسلوب وسائل التواصل الاجتماعي في الخليج. افتح متجرك خلال دقائق بدل دفع إيجار محل، وانشر منتجاتك بالصور، ودع المشترين يجدونها ويحفظونها ويطلبونها عبر واتساب. قريباً في الكويت والسعودية والإمارات والبحرين وقطر وعُمان." jsonld={jsonld}>
<header class="top"><a href="/ar/" class="brand" aria-label="الصفحة الرئيسية لماي بوتيكي" dir="ltr"><img src="/img/mark.svg" alt="" width="64" height="41" /><span>myboutki</span></a><nav aria-label="الأقسام"><a href="#why">لماذا ماي بوتيكي</a><a href="#how">كيف يعمل</a><a href="#faq">الأسئلة الشائعة</a><a href="/about/" class="lang" hreflang="en" lang="en">English</a></nav></header>
<main>
  <section class="wrap hero-wrap">
    <div class="hero">
      <p class="eyebrow"><span class="dot"></span>قريباً</p>
      <h1>بِع أونلاين بدون إيجار محل</h1>
      <p class="lead"><strong>ماي بوتيكي</strong> سوق إلكتروني بأسلوب وسائل التواصل الاجتماعي مصمم للبائعين. افتح متجرك خلال دقائق، وانشر منتجاتك بالصور، ودع المشترين في أنحاء الخليج يجدونها ويحفظونها ويطلبونها عبر واتساب — بدون إيجار ولا تكاليف تأسيس.</p>
      <ul class="cats" aria-label="الفئات">{cats.map(c => <li>{c}</li>)}</ul>
      <p class="where">قريباً في {countries.join(' · ')}</p>
    </div>
    <div class="gallery" aria-label="منتجات على ماي بوتيكي">
      {shots.map(([src, alt], i) => <figure class={`g g${i}`}><img src={src} alt={alt} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" /></figure>)}
    </div>
  </section>
  <section id="why" class="band soft"><div class="wrap1">
    <h2>لماذا تدفع إيجار محل؟</h2>
    <p class="sub">استئجار محل يعني عقداً وتأميناً وفواتير شهرية قبل أن تبيع قطعة واحدة. ماي بوتيكي يمنح كل بائع مكاناً مخصصاً للبيع أونلاين، مصمماً مثل تطبيقات التواصل التي يستخدمها الناس كل يوم.</p>
    <div class="compare">
      <div class="col"><h3>استئجار محل</h3><ul><li>إيجار شهري وعقد طويل</li><li>تأمين وديكور وموظفون</li><li>لا يراك إلا المارّة</li><li>ساعات عمل محددة</li></ul></div>
      <div class="col good"><h3>البيع على ماي بوتيكي</h3><ul><li>ملف متجر خاص بك بدون إيجار</li><li>انشر منتجاتك من هاتفك في ثوانٍ</li><li>يجدك المشترون في ست دول خليجية</li><li>مفتوح 24 ساعة، والطلبات مباشرة على واتساب</li></ul></div>
    </div></div></section>
  <section class="band"><div class="wrap1">
    <h2>سوق اجتماعي للبيع والشراء</h2>
    <p class="sub">ماي بوتيكي مكان مخصص للمنتجات: كل منشور شيء يمكنك شراؤه، وكل ملف متجر، وكل بحث يقودك إلى بائعين قريبين منك.</p>
    <div class="grid">{features.map(([t,d]) => <article class="feat"><h3>{t}</h3><p>{d}</p></article>)}</div>
  </div></section>
  <section id="how" class="band soft"><div class="wrap1 two">
    <div><h2>للبائعين</h2><ol class="steps"><li><b>سجّل الدخول بحساب Google</b> واختر اسم متجرك.</li><li><b>انشر منتجاتك</b> بالصور والسعر والوصف.</li><li><b>استقبل الطلبات على واتساب</b> مع قائمة بكل المنتجات.</li><li><b>نمِّ متجرك</b> بالمتابعين وإعادة النشر والشارة الموثّقة.</li></ol></div>
    <div><h2>للمشترين</h2><ol class="steps"><li><b>تصفح المنشورات</b> أو ابحث حسب الفئة.</li><li><b>احفظ وأعجب</b> بالمنتجات التي تحبها.</li><li><b>راسل البائعين</b> واسألهم.</li><li><b>اطلب عبر واتساب</b> بضغطة واحدة.</li></ol></div>
  </div></section>
  <section class="band"><div class="wrap1">
    <h2>تسوّق وبِع في أنحاء الخليج</h2>
    <p class="sub">بِع العبايات والساعات والحقائب ومنتجات التجميل وغيرها لمشترين في {countries.join('، ')}. تظهر الأسعار بعملة كل دولة.</p>
    <ul class="cats big" aria-label="ماذا يمكنك أن تبيع">{cats.map(c => <li>{c}</li>)}</ul>
  </div></section>
  <section id="faq" class="band soft"><div class="wrap1 narrow">
    <h2>الأسئلة الشائعة</h2>
    {faq.map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
  </div></section>
</main>
<footer><p>© {new Date().getFullYear()} ماي بوتيكي — السوق الاجتماعي للبائعين في الخليج.</p><p>تحتاج مساعدة؟ <a href="mailto:support@myboutki.com" dir="ltr">support@myboutki.com</a></p></footer>
</Base>
<style is:global>
  :root{color-scheme:light;--ink:#111;--muted:#6f6f6f;--gold:#b8913e;--soft:#f8f6f1;--line:#ece8df}
  *{box-sizing:border-box;margin:0}
  html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:20px}
  body{font:16px/1.65 Inter,'Plex Arabic',system-ui,-apple-system,sans-serif;color:var(--ink);background:#fff}
  img{max-width:100%}
  .top{max-width:1180px;margin:0 auto;padding:16px 22px;display:flex;align-items:center;justify-content:space-between;gap:16px}
  .brand{display:flex;align-items:center;gap:8px;text-decoration:none;color:var(--ink)}.brand img{width:62px;height:auto;display:block}.brand span{font-family:'Playfair Display',Georgia,serif;font-size:28px;font-weight:600;letter-spacing:.2px}
  .top nav{display:flex;gap:22px;flex-wrap:wrap}.top nav a{color:var(--ink);text-decoration:none;font-size:14px;font-weight:500}.top nav a:hover{color:var(--gold)}.top nav a.lang{border:1px solid var(--line);border-radius:999px;padding:2px 12px;font-family:'Plex Arabic',Tahoma,sans-serif}
  .wrap{max-width:1180px;margin:0 auto;padding:clamp(18px,4vw,48px) 22px clamp(40px,6vw,80px);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(28px,5vw,72px);align-items:center}
  .hero{display:flex;flex-direction:column;align-items:flex-start}
  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:600;color:var(--gold);background:#f8f1e1;padding:6px 12px;border-radius:999px}
  .dot{width:8px;height:8px;border-radius:50%;background:var(--gold);animation:pulse 1.8s infinite}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(184,145,62,.6)}70%{box-shadow:0 0 0 8px rgba(184,145,62,0)}100%{box-shadow:0 0 0 0 rgba(184,145,62,0)}}
  h1{font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:clamp(40px,6vw,68px);line-height:1.05;letter-spacing:-.4px;margin:16px 0 16px;text-wrap:balance}
  h2{font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:clamp(28px,3.6vw,40px);line-height:1.15;margin:0 0 12px;text-wrap:balance}
  h3{font-size:17px;font-weight:600;margin:0 0 6px}
  .lead{font-size:clamp(16px,1.6vw,18px);color:#3d3d3d;max-width:34em}
  .sub{color:#4a4a4a;max-width:46em;margin-bottom:26px;font-size:17px}
  .cats{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 16px}
  .cats li{font-size:13px;padding:6px 12px;border:1px solid var(--line);border-radius:999px;background:#fff}
  .cats.big li{font-size:15px;padding:9px 16px}
  .where{font-size:13px;color:var(--muted)}
  .gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(6,minmax(0,1fr));gap:12px;aspect-ratio:4/5;width:100%}
  .g{border-radius:18px;overflow:hidden;background:var(--soft);box-shadow:0 10px 30px rgba(17,17,17,.08)}
  .g img{width:100%;height:100%;object-fit:cover;display:block}
  .g0{grid-row:1/5}.g1{grid-row:1/3}.g2{grid-row:3/7}.g3{grid-row:5/7}.g0 img{object-position:center 20%}.g3 img{object-position:center 40%}
  .band{padding:clamp(48px,7vw,88px) 22px}.band.soft{background:var(--soft)}
  .wrap1{max-width:1180px;margin:0 auto}.wrap1.narrow{max-width:820px}
  .compare{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .col{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px}.col ul{padding-left:20px;color:#444}.col li{margin:6px 0}
  .col.good{border:2px solid var(--gold)}.col.good h3{color:var(--gold)}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
  .feat{border:1px solid var(--line);border-radius:16px;padding:20px;background:#fff}.feat p{color:#4a4a4a;font-size:15px}
  .two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:40px}
  .steps{padding-left:22px}.steps li{margin:10px 0;color:#3d3d3d}
  details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-bottom:10px}
  summary{cursor:pointer;font-weight:600}details p{color:#4a4a4a;margin-top:8px}
  .ar{font-family:'Plex Arabic',Tahoma,sans-serif;text-align:right}.ar h2{font-family:'Amiri','Plex Arabic',serif;font-weight:700;font-size:clamp(28px,3.4vw,38px);line-height:1.45}.ar p{font-size:17px;line-height:1.9;color:#3d3d3d}
  footer{text-align:center;font-size:13px;color:var(--muted);padding:26px 22px;border-top:1px solid var(--line)}footer p{margin:3px 0}
  footer a{color:var(--gold);font-weight:600;text-decoration:none}
  @media(max-width:860px){.wrap{grid-template-columns:minmax(0,1fr)}.hero{align-items:center;text-align:center}.cats{justify-content:center}.gallery{max-width:520px;margin:0 auto}.compare,.two{grid-template-columns:minmax(0,1fr)}.top nav{gap:14px}}
  @media(max-width:480px){.top nav a:not(.lang){display:none}}
  @media(prefers-reduced-motion:reduce){.dot{animation:none}html{scroll-behavior:auto}}
  html[dir=rtl] body{font-family:'Plex Arabic',Inter,Tahoma,sans-serif;font-size:17px;line-height:1.85}
  html[dir=rtl] *{letter-spacing:0!important}
  html[dir=rtl] h1,html[dir=rtl] h2{font-family:'Amiri','Plex Arabic',serif;font-weight:700;line-height:1.4}
  html[dir=rtl] h1{font-size:clamp(42px,6vw,72px);line-height:1.25;margin:14px 0 18px}
  html[dir=rtl] h2{font-size:clamp(32px,4vw,46px)}
  html[dir=rtl] h3{font-weight:600;font-size:18px}
  html[dir=rtl] summary{font-weight:600}
  html[dir=rtl] .eyebrow,html[dir=rtl] .cats li,html[dir=rtl] .top nav a{font-weight:500}
  html[dir=rtl] .col ul,html[dir=rtl] .steps{padding-left:0;padding-right:22px}
  html[dir=rtl] .lead,html[dir=rtl] .sub{line-height:1.9}
  html[dir=rtl] .brand span{font-family:'Playfair Display',Georgia,serif}
  html[dir=rtl] .top nav a.lang{font-family:Inter,system-ui,sans-serif}
</style>
