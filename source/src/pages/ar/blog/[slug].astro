---
import Blog from '../../../layouts/Blog.astro';
import { posts } from '../../../blog/posts.js';
export function getStaticPaths() { return posts.map(p => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const SITE = 'https://myboutki.com', url = `${SITE}/ar/blog/${p.slug}/`;
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: p.ar.title, description: p.ar.desc, image: SITE + p.img, datePublished: p.date, dateModified: p.date, inLanguage: 'ar', mainEntityOfPage: url,
    author: { '@type': 'Organization', name: 'myboutiki', url: SITE }, publisher: { '@type': 'Organization', name: 'myboutiki', logo: { '@type': 'ImageObject', url: SITE + '/img/favicon.png?v=2' } } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'myboutiki', item: SITE + '/' }, { '@type': 'ListItem', position: 2, name: 'المدونة', item: SITE + '/ar/blog/' }, { '@type': 'ListItem', position: 3, name: p.ar.title, item: url }] },
];
const more = posts.filter(x => x.slug !== p.slug).slice(0, 3);
---
<Blog lang="ar" title={p.ar.title + ' | myboutiki'} description={p.ar.desc} path={`/ar/blog/${p.slug}/`} jsonld={jsonld} image={SITE + p.img} ogType="article">
  <article>
    <p><a href="/ar/blog/" class="meta">→ كل المقالات</a></p>
    <span class="tag">{p.ar.tag}</span>
    <h1>{p.ar.title}</h1>
    <p class="meta">ماي بوتيكي · <time datetime={p.date}>{new Date(p.date).toLocaleDateString('ar-KW-u-nu-latn', { day: 'numeric', month: 'long', year: 'numeric' })}</time></p>
    <img class="hero" src={p.img} alt={p.ar.title} width="1200" height="675" />
    <Fragment set:html={p.ar.body} />
  </article>
  <h2 style="margin-top:44px">المزيد من المدونة</h2>
  <div class="cards">{more.map(x => <a class="card" href={`/ar/blog/${x.slug}/`}><img src={x.img} alt="" loading="lazy" decoding="async" /><div><span class="tag">{x.ar.tag}</span><h2>{x.ar.title}</h2></div></a>)}</div>
</Blog>
