---
const {
  title = 'myboutki — Sell online without renting a shop | Social marketplace for the Gulf',
  description = 'myboutki is a social media marketplace for the Gulf. Open your own online shop in minutes instead of paying rent for a store, post items with photos, and let buyers find, save and order on WhatsApp. Coming soon to Kuwait, Saudi Arabia, UAE, Bahrain, Qatar and Oman.',
  path = '/',
  jsonld = [],
  lang = 'en',
  image = 'https://myboutki.com/img/og.jpg?v=2',
  ogType = 'website',
} = Astro.props;
const url = new URL(path, 'https://myboutki.com').href;
const enPath = path.replace(/^\/ar\//, '/');
const enUrl = new URL(enPath, 'https://myboutki.com').href;
const arUrl = new URL('/ar' + enPath, 'https://myboutki.com').href;
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href={url} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="ar" href={arUrl} />
<link rel="alternate" hreflang="x-default" href={enUrl} />
<meta name="application-name" content="myboutki" />
<meta name="apple-mobile-web-app-title" content="myboutki" />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="myboutki" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="myboutki — shop and sell with your community" />
<meta property="og:locale" content={lang === 'ar' ? 'ar_KW' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_KW'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="theme-color" content="#ffffff" />
<link rel="icon" type="image/svg+xml" href="/img/mark.svg?v=2" />
<link rel="icon" type="image/png" sizes="512x512" href="/img/favicon.png?v=2" />
<link rel="apple-touch-icon" href="/img/favicon.png?v=2" />
<link rel="sitemap" href="/sitemap.xml" />
<link rel="stylesheet" href="/fonts/ar.css" />
{lang === 'ar' && <link rel="preload" href="/fonts/ibm-plex-sans-arabic-arabic-400-normal.woff2" as="font" type="font/woff2" crossorigin />}
{lang === 'ar' && <link rel="preload" href="/fonts/amiri-arabic-700-normal.woff2" as="font" type="font/woff2" crossorigin />}
<link rel="preload" as="image" href="/img/mark.svg?v=2" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
{jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body><slot /></body>
</html>
