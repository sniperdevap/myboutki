---
import Base from './Base.astro';
const { lang = 'en', title, description, path, jsonld = [], image, ogType = 'website' } = Astro.props;
const ar = lang === 'ar';
const home = ar ? '/ar/' : '/';
---
<Base lang={lang} title={title} description={description} path={path} jsonld={jsonld} image={image} ogType={ogType}>
<header class="bt">
  <a href={home} class="brand" aria-label="myboutki" dir="ltr"><img src="/img/mark.svg" alt="" width="54" height="35" /><span>myboutki</span></a>
  <nav>
    <a href={ar ? '/ar/blog/' : '/blog/'}>{ar ? 'المدونة' : 'Blog'}</a>
    <a href={ar ? '/ar/about/' : '/about/'}>{ar ? 'عن ماي بوتيكي' : 'About'}</a>
    <a href={ar ? path.replace(/^\/ar/, '') : '/ar' + path} lang={ar ? 'en' : 'ar'} hreflang={ar ? 'en' : 'ar'} class="lang">{ar ? 'English' : 'العربية'}</a>
    <a href={home} class="go">{ar ? 'افتح ماي بوتيكي' : 'Open myboutki'}</a>
  </nav>
</header>
<main class="bw"><slot /></main>
<footer class="bf"><p>© {new Date().getFullYear()} myboutki · {ar ? 'الكويت · السعودية · الإمارات · البحرين · قطر · عُمان' : 'Kuwait · Saudi Arabia · UAE · Bahrain · Qatar · Oman'}</p><p><a href={home}>{ar ? 'المتجر' : 'Shop'}</a> · <a href={ar ? '/ar/blog/' : '/blog/'}>{ar ? 'المدونة' : 'Blog'}</a> · <a href="mailto:support@myboutki.com">{ar ? 'الدعم' : 'Support'}</a></p></footer>
<style is:global>
:root{--ink:#111;--muted:#6f6f6f;--gold:#b8913e;--soft:#f8f6f1;--line:#ece8df;--blue:#4A5DF9}
*{box-sizing:border-box}html,body{margin:0}
body{font:17px/1.7 Inter,system-ui,-apple-system,'Segoe UI',Roboto,'Plex Arabic',sans-serif;color:var(--ink);background:#fff}
html[dir=rtl] body{font-family:'Plex Arabic',Inter,system-ui,sans-serif}
a{color:inherit}
.bt{display:flex;align-items:center;gap:16px;justify-content:space-between;max-width:1080px;margin:0 auto;padding:16px 20px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.bt .brand{display:flex;align-items:center;gap:6px;text-decoration:none;font-family:'Playfair Display',Georgia,serif;font-size:24px;font-weight:600}
.bt nav{display:flex;gap:16px;align-items:center;font-size:15px;flex-wrap:wrap}.bt nav a{text-decoration:none;color:var(--muted)}.bt nav a:hover{color:var(--ink)}
.bt .go{background:var(--ink);color:#fff!important;padding:8px 14px;border-radius:999px}
.bw{max-width:760px;margin:0 auto;padding:28px 20px 60px}
.bw h1{font-family:'Playfair Display',Georgia,serif;font-size:clamp(30px,5vw,44px);line-height:1.15;margin:8px 0 14px;font-weight:600}
html[dir=rtl] .bw h1,html[dir=rtl] .bw h2{font-family:'Amiri','Plex Arabic',serif;line-height:1.4}
.bw h2{font-size:24px;margin:34px 0 10px;line-height:1.3}
.bw p,.bw li{color:#2a2a2a}.bw li{margin:6px 0}.bw a{color:var(--blue)}
.bw .meta{color:var(--muted);font-size:14px}.bw .tag{display:inline-block;background:var(--soft);color:var(--gold);font-weight:600;font-size:13px;padding:3px 10px;border-radius:999px}
.bw .hero{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:16px;margin:16px 0 8px;background:var(--soft)}
.bw table{width:100%;border-collapse:collapse;font-size:15px;margin:12px 0}.bw td,.bw th{border-bottom:1px solid var(--line);padding:10px 8px;text-align:start;vertical-align:top}.bw th{font-weight:600;background:var(--soft)}
.bw .note{background:var(--soft);border-radius:12px;padding:12px 14px;font-size:15px;color:var(--muted)}
.cta{margin:36px 0 0;padding:22px;border-radius:18px;background:var(--ink);color:#fff}.cta b{font-size:20px}.cta p{color:#ddd!important;margin:6px 0 14px}.cta .btn{display:inline-block;background:#fff;color:var(--ink)!important;text-decoration:none;font-weight:600;padding:10px 18px;border-radius:999px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px;margin-top:22px}
.card{display:block;text-decoration:none;border:1px solid var(--line);border-radius:18px;overflow:hidden;background:#fff;transition:transform .15s,box-shadow .15s}.card:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(0,0,0,.07)}
.card img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block;background:var(--soft)}.card div{padding:14px 16px 18px}.card h2{font-size:19px;margin:8px 0 6px;color:var(--ink)}.card p{font-size:15px;color:var(--muted);margin:0}
.bf{border-top:1px solid var(--line);text-align:center;color:var(--muted);font-size:14px;padding:22px 20px 40px}.bf a{color:var(--muted)}
</style>
</Base>
